erDiagram
    User ||--o{ Order : places
    Restaurant ||--o{ Dish : offers
    Restaurant ||--o{ Order : processes
    Courier ||--o{ Order : delivers
    Order ||--|{ OrderItem : contains
    Dish ||--o{ OrderItem : included_in

    User {
        string id PK "UUID"
        string name
        string email
        string phone
        datetime created_at
    }

    Restaurant {
        string id PK "UUID"
        string name
        string address
        float rating
    }

    Dish {
        string id PK "UUID"
        string restaurant_id FK "UUID"
        string title
        decimal price
        boolean is_available
    }

    Order {
        string id PK "UUID"
        string user_id FK "UUID"
        string restaurant_id FK "UUID"
        string courier_id FK "UUID"
        string status
        decimal total_amount
        datetime created_at
    }

    OrderItem {
        string id PK "UUID"
        string order_id FK "UUID"
        string dish_id FK "UUID"
        int quantity
        decimal price_at_order
    }

    Courier {
        string id PK "UUID"
        string name
        string vehicle_type
        boolean is_active
    }